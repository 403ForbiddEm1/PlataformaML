# Este archivo lista TODAS las variables de entorno del monorepo.
# Cada componente tiene su propio .env.example con las que le corresponden.
# Consulta backend/README.md, frontend/README.md y ml-service/README.md para más detalle.

# ── Backend ────────────────────────────────────────────────────
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/plataforma_db?schema=public"
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_IN=1h
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=

# ── Frontend ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_USE_MOCK=false

# ── ML Service ─────────────────────────────────────────────────
ML_API_KEY=
ML_MODEL_PATH=trained-models/
