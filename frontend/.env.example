# Variables de Entorno del Frontend
# Configuración de Conexión con el Backend Node.js / Express y FastAPI ML

# URL base del Backend Node.js / Express
VITE_API_URL=http://localhost:4000/api

# Microservicio de Machine Learning (FastAPI)
VITE_ML_API_URL=http://localhost:8000

# Modo de datos ('false' para conectar al backend real)
VITE_USE_MOCK=false

# Cliente Google OAuth (opcional)
VITE_GOOGLE_CLIENT_ID=
