# Nexo Tecnología - Variables de Entorno del Frontend
# Configuración de Conexión con el Backend Node.js / Express y FastAPI ML

# URL base del Backend Node.js / Express
VITE_API_URL=http://localhost:4000/api

# Microservicio de Machine Learning (FastAPI) si se conecta directamente
VITE_ML_API_URL=http://localhost:8000/api

# Modo de datos:
# 'true': Utiliza la capa de almacenamiento simulado reactivo (LocalStorage) para pruebas y demostración sin backend.
# 'false': Se conecta a los endpoints HTTP reales del backend Node.js / Express.
VITE_USE_MOCK=true

# Título de la aplicación
VITE_APP_TITLE=Nexo Tecnología · Portal de Talento
