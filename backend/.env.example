# ── Base de datos ──────────────────────────────────────────────
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/plataforma_db?schema=public"

# ── Servidor ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
APP_NAME="Plataforma de Reclutamiento"

# ── Autenticación ─────────────────────────────────────────────
# Genera un secreto: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ── Cuenta Super Administrador (se crea/actualiza al arrancar) ─
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Servicio de ML ─────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=

# ── Telegram API por Empresa (https://my.telegram.org) ────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

