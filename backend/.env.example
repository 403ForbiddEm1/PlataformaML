# ── Base de datos ──────────────────────────────────────────────
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/plataforma_db?schema=public"

# ── Servidor ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── Autenticación ─────────────────────────────────────────────
# Genera un secreto: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ── Servicio de ML ─────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=