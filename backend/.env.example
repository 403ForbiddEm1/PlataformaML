# ── Base de datos ──────────────────────────────────────────────
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/plataforma_db?schema=public"

# ── Servidor ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
APP_NAME="Plataforma de Reclutamiento"

# ── Autenticación ─────────────────────────────────────────────
# Genera un secreto: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ── Cuenta Super Administrador (se crea/actualiza al arrancar) ─
SUPER_ADMIN_EMAIL=superadmin@plataforma.test
SUPER_ADMIN_PASSWORD=Password123!

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Servicio de ML ─────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=

# ── Correo SMTP (opcional en desarrollo, fallback a consola) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plataforma Reclutamiento <no-reply@plataforma.test>"

# ── WhatsApp Cloud API (opcional en desarrollo, fallback a consola)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
